            },
            {
              "kind": "read",
              "text": "Rooks go in the corners, knights next to them, then bishops.",
              "fen": "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1",
              "marks": ["a1", "h1", "b1", "g1", "c1", "f1"]
