          "title": "Squares and their names",
          "steps": [
            {
              "kind": "read",
              "text": "The board has 64 squares. Columns are called files, a to h. Rows are called ranks, 1 to 8.",
              "fen": "8/8/8/8/8/8/8/8 w - - 0 1",
              "marks": ["a1", "b1", "c1", "d1", "e1", "f1", "g1", "h1"]
            },
            {
              "kind": "read",
              "text": "A square is named by its file, then its rank. This square is e4.",
              "fen": "8/8/8/8/8/8/8/8 w - - 0 1",
              "marks": ["e4"]
            },
            {
              "kind": "tap",
              "prompt": "Tap e4.",
