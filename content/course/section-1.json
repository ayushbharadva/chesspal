        {
          "id": "goal-of-chess",
          "title": "The goal of chess",
          "steps": [
            {
              "kind": "read",
              "text": "Chess is a game for two players, White and Black. White moves first, then you take turns.",
              "fen": "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1"
            },
            {
              "kind": "choice",
              "prompt": "Who makes the first move?",
              "options": ["White", "Black"],
              "answer": 0,
              "explanation": "White always moves first."
            },
            {
              "kind": "read",
              "text": "You win by trapping the other king so it has no way out. That is called checkmate.",
              "fen": "R5k1/5ppp/8/8/8/8/5PPP/6K1 b - - 1 1",
              "marks": ["g8"],
              "arrows": [["a8", "g8"]]
            },
            {
              "kind": "choice",
              "prompt": "How do you win a game of chess?",
              "options": ["Take every piece", "Checkmate the king", "Reach the far side"],
              "answer": 1,
              "explanation": "You win by checkmate. You never actually take the king."
            },
            {
              "kind": "read",
              "text": "Each side has 16 pieces: a king, a queen, two rooks, two bishops, two knights and eight pawns.",
              "fen": "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1"
            },
            {
              "kind": "choice",
              "prompt": "How many pawns does each side start with?",
              "options": ["Six", "Eight", "Ten"],
              "answer": 1,
              "explanation": "Eight pawns stand in a row in front of the other pieces."
            }
          ]
        },
        {
